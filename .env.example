# ─────────────────────────────────────────────────────────────
# VisiTrack environment variables
# Copy to .env.local for local development, and add the same
# keys under Project Settings → Environment Variables in Vercel.
# ─────────────────────────────────────────────────────────────

# Supabase project (create it in an EU region, e.g. eu-north-1 Stockholm
# or eu-central-1 Frankfurt). Found under Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Server-only (never prefix with NEXT_PUBLIC_). REQUIRED: used by the daily snapshot
# purge job AND to serve snapshot images - without it, photos fail to load in the admin UI.
# Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Any long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Canonical public address. REQUIRED: password reset refuses to build links from
# request headers, so without this the reset form returns a configuration error.
# Read at build time (NEXT_PUBLIC_), so changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=https://www.visitrack.se

# Emailing a worker their QR code (admin → Personal → Mejla QR-koden).
# Without these the button answers "E-postutskick är inte konfigurerat".
# The mail carries a link to /kod/<token>, never the code itself, so the badge
# stays on visitrack.se; the provider only ever sees the name and the link.
RESEND_API_KEY=re_xxxx
# Must be on a domain verified in Resend, e.g. the send. subdomain.
BADGE_MAIL_FROM=VisiTrack <no-reply@send.visitrack.se>
# Where a reply goes. Someone whose code will not scan will hit reply, and a
# no-reply box means the school never hears about it.
BADGE_MAIL_REPLY_TO=expedition@skolan.se
